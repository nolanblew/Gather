# Copy to .env to override defaults. Never commit a real API key.
SEARCH_PROVIDER=local
GATHER_CPUS=0.5
GATHER_MEMORY_LIMIT=512m
SEARCH_IDLE_MS=300000
SEARCH_MAX_EMBEDDINGS=4096
SEARCH_INDEX_BATCH_LIMIT=64
# Hosted ranking is optional; change SEARCH_PROVIDER to openai to enable.
OPENAI_API_KEY=
SEARCH_OPENAI_MODEL=gpt-6-luna
SEARCH_REASONING_EFFORT=low
SEARCH_OPENAI_BASE_URL=https://api.openai.com/v1/
